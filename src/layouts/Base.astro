---
import '../styles/global.css';
import { Font, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Analytics from '@vercel/analytics/astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import LeadPopup from '../components/LeadPopup.astro';
import JsonLd from '../components/JsonLd.astro';
import { site } from '../data/site';
import { img } from '../lib/images';
import { graph, resortSchema, websiteSchema } from '../lib/schema';
import { getRooms, totals } from '../lib/inventory';

interface Props {
  title: string;
  description: string;
  ogImage?: ImageMetadata;
  ogAlt?: string;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** html lang, e.g. 'en-IN' or 'ml-IN' */
  lang?: string;
  /** hreflang alternates: [{ lang: 'ml-IN', href: '/ml/' }, ...] — include this page too */
  alternates?: { lang: string; href: string }[];
}

const {
  title,
  description,
  ogImage = img('hero/wayanad-tea-estate-misty-hills'),
  ogAlt = 'Tea estates and misty hills in Wayanad, Kerala',
  schema = [],
  noindex = false,
  lang = 'en-IN',
  alternates = [],
} = Astro.props;

const siteUrl = Astro.site!;
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const og = await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, siteUrl).href;
const heroOg = await getImage({ src: img('hero/wayanad-tea-estate-misty-hills'), width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });

const units = totals(await getRooms()).units;
const ld = graph(websiteSchema(siteUrl), resortSchema(siteUrl, new URL(heroOg.src, siteUrl).href, units), ...schema);
const staging = __SITE_STAGING__;
const analytics = import.meta.env.PUBLIC_ANALYTICS === 'true';
const ga4 = import.meta.env.PUBLIC_GA4_ID as string | undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || staging) && <meta name="robots" content={staging ? 'noindex, nofollow' : 'noindex, follow'} />}
    <meta name="theme-color" content="#24493a" />
    <meta name="geo.region" content="IN-KL" />
    <meta name="geo.placename" content={`${site.address.locality}, ${site.address.district}, ${site.address.region}`} />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    <meta name="ICBM" content={`${site.geo.lat}, ${site.geo.lng}`} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.href, siteUrl).href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(alternates[0].href, siteUrl).href} />}
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {!staging && <link rel="sitemap" href="/sitemap-index.xml" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={lang.replace('-', '_')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <JsonLd data={ld} />
    <script type="speculationrules" is:inline>
      {"prerender":[{"where":{"href_matches":"/*"},"eagerness":"moderate"}]}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {
      staging && (
        <p class="staging-banner" role="note">
          Preview site: the resort name, prices, policies and room photos are placeholders until launch.
        </p>
      )
    }
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileActionBar />
    <LeadPopup />
    {analytics && <Analytics />}
    {
      ga4 && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`} />
          <script is:inline define:vars={{ ga4 }}>
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () {
              dataLayer.push(arguments);
            };
            gtag('js', new Date());
            gtag('config', ga4);
          </script>
        </>
      )
    }
    <script is:inline>
      // Conversion events (no personal data): WhatsApp/phone clicks and enquiry submits.
      (() => {
        const send = (name, data) => {
          (window.dataLayer = window.dataLayer || []).push({ event: name, ...data });
          if (window.gtag) gtag('event', name, data);
          if (window.va) va('event', { name, data });
        };
        document.addEventListener('click', (e) => {
          const a = e.target.closest && e.target.closest('a[href]');
          if (!a) return;
          const h = a.getAttribute('href');
          const where = a.dataset.track || (a.closest('section,header,footer,nav,[role=group]') || {}).id || 'page';
          if (/wa\.me|api\.whatsapp\.com/.test(h)) send('whatsapp_click', { page: location.pathname, where });
          else if (h.startsWith('tel:')) send('phone_click', { page: location.pathname, where });
        });
        document.addEventListener('submit', (e) => {
          if (e.target.matches && e.target.matches('[data-enquiry]')) send('enquiry_submit', { page: location.pathname });
        }, true);
      })();
    </script>
  </body>
</html>

<style>
  .staging-banner {
    margin: 0;
    padding: 0.45rem 1rem;
    background: var(--pepper);
    color: #fff;
    font-size: 0.8rem;
    text-align: center;
  }
</style>

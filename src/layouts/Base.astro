---
import '../styles/global.css';
import { Font, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Analytics from '@vercel/analytics/astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import JsonLd from '../components/JsonLd.astro';
import { site } from '../data/site';
import { img } from '../lib/images';
import { graph, resortSchema, websiteSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  ogImage?: ImageMetadata;
  ogAlt?: string;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = img('hero/wayanad-tea-estate-misty-hills'),
  ogAlt = 'Tea estates and misty hills in Wayanad, Kerala',
  schema = [],
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site!;
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const og = await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, siteUrl).href;
const heroOg = await getImage({ src: img('hero/wayanad-tea-estate-misty-hills'), width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });

const ld = graph(websiteSchema(siteUrl), resortSchema(siteUrl, new URL(heroOg.src, siteUrl).href), ...schema);
const analytics = import.meta.env.PUBLIC_ANALYTICS === 'true';
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#24493a" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <JsonLd data={ld} />
    <script type="speculationrules" is:inline>
      {"prerender":[{"where":{"href_matches":"/*"},"eagerness":"moderate"}]}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <FloatingWhatsApp />
    {analytics && <Analytics />}
  </body>
</html>

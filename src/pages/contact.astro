---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import MapSchematic from '../components/MapSchematic.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import HowItWorks from '../components/HowItWorks.astro';
import { site } from '../data/site';
import { reach } from '../data/places';
import { breadcrumbSchema } from '../lib/schema';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Contact', href: '/contact/' },
];
---

<Base
  keywords={['Wayanad resort booking', 'Wayanad resort contact number', 'book resort in Wayanad WhatsApp', 'how to reach Wayanad']}
  title={`Contact ${site.shortName} – Wayanad Resort Booking on WhatsApp`}
  description={`Contact ${site.name} on WhatsApp ${site.phone} to book a resort in Wayanad. How booking works, resort rules and how to reach Wayanad.`}
  schema={[breadcrumbSchema(crumbs, Astro.site!)]}
>
  <PageHero
    title="Contact us and book a Wayanad resort"
    lede="WhatsApp is the fastest way to reach us. Send your dates, the number of guests and your budget."
    crumbs={crumbs}
  />

  <section class="section">
    <div class="wrap split">
      <div>
        <h2>{site.name}</h2>
        <address>
          Resort booking for all of Wayanad, Kerala<br />
          WhatsApp and phone: <a href={`tel:${site.phoneE164}`}>{site.phone}</a>
        </address>
        <div class="actions">
          <WhatsAppButton label="Chat on WhatsApp" />
          <a class="btn btn--ghost" href={`tel:${site.phoneE164}`}>Call {site.phone}</a>
        </div>

        <h2 class="reach-title">How to reach Wayanad</h2>
        <div class="table-scroll">
          <table>
            <thead>
              <tr><th scope="col">From</th><th scope="col">Distance</th><th scope="col">Time</th><th scope="col">Route</th></tr>
            </thead>
            <tbody>
              {
                reach.map((r) => (
                  <tr>
                    <th scope="row">{r.href ? <a href={r.href}>{r.from}</a> : r.from}</th>
                    <td>{r.km}</td>
                    <td>{r.time}</td>
                    <td>{r.note}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="muted">
          Distances are to Vythiri in south Wayanad; your resort may be closer or further. Drive the Thamarassery Ghat in daylight
          if you can, and expect slow traffic on weekends.
        </p>
      </div>
      <MapSchematic />
    </div>
  </section>

  <section class="section" id="policies">
    <div class="wrap">
      <h2>How booking works</h2>
      <HowItWorks />
      <h3 class="rules-title">Resort rules</h3>
      <p class="narrow">
        Every resort has its own check-in time, advance payment, cancellation rule, children's policy and pet policy. We send
        you the rules of the resort you choose before you pay. Every adult needs a government photo ID at check-in; this is
        required by law in India.
      </p>
    </div>
  </section>

  <section class="section section--tea">
    <div class="wrap">
      <h2>Send an enquiry</h2>
      <p class="lede">Pick your dates and we will reply on WhatsApp with resorts that are free, with photos and the rate.</p>
      <EnquiryForm />
    </div>
  </section>
</Base>

<style>
  .split {
    display: grid;
    gap: var(--space-l);
    align-items: start;
  }
  @media (min-width: 900px) {
    .split {
      grid-template-columns: 1.2fr 1fr;
    }
  }
  address {
    font-style: normal;
    line-height: 1.9;
    margin-bottom: 1.4rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  .reach-title {
    margin-top: var(--space-l);
  }
  table {
    min-width: 36rem;
    background: var(--paper);
  }
  .muted {
    margin-top: 0.8rem;
  }
  .rules-title {
    margin-top: var(--space-l);
  }
  .narrow {
    max-width: 65ch;
  }
</style>

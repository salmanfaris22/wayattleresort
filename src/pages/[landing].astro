---
// Programmatic SEO landing pages: one page per real search intent, built from
// src/content/landing/*.md + live room data. Pages that fail the quality gate
// (src/lib/landing.ts) are not built, so they never reach the sitemap.
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import AnswerBox from '../components/AnswerBox.astro';
import RoomCard from '../components/RoomCard.astro';
import PlaceTable from '../components/PlaceTable.astro';
import Faq from '../components/Faq.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import RelatedPages from '../components/RelatedPages.astro';
import TrustBlock from '../components/TrustBlock.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getLandingPages, makeFiller, type Landing } from '../lib/landing';
import { getRooms } from '../lib/inventory';
import { img } from '../lib/images';
import { site } from '../data/site';
import { breadcrumbSchema, faqSchema, stayListSchema, webPageSchema } from '../lib/schema';

export async function getStaticPaths() {
  const { published } = await getLandingPages();
  return published.map((page) => ({ params: { landing: page.id }, props: { page } }));
}

interface Props {
  page: Landing;
}
const { page } = Astro.props;
const d = page.data;
const rooms = await getRooms();
const fill = makeFiller(rooms);
const { Content } = await render(page);

const url = new URL(`/${page.id}/`, Astro.site).href;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: d.breadcrumb, href: `/${page.id}/` },
];
const matched = d.rooms
  .map((r) => ({ room: rooms.find((x) => x.id === r.id)!, note: fill(r.note) }))
  .filter((r) => r.room);


const faqs = d.faqs.map((f) => ({ q: fill(f.q), a: fill(f.a) }));
const answer = { q: fill(d.answer.q), a: fill(d.answer.a) };
const title = fill(d.seoTitle);
const description = fill(d.description);
const listId = `${url}#rooms`;
const schema = [
  webPageSchema({ url, name: fill(d.h1), description, updated: d.updated, mainEntityId: matched.length ? listId : undefined }, Astro.site!),
  breadcrumbSchema(crumbs, Astro.site!),
  ...(matched.length ? [stayListSchema(matched.map((m) => ({ id: m.room.id, name: m.room.data.name })), listId, `Stays for: ${d.breadcrumb}`, Astro.site!)] : []),
  faqSchema(faqs),
];
---

<Base title={title} description={description} keywords={[d.primaryKeyword, ...d.secondaryKeywords]} ogImage={img(d.heroImage)} ogAlt={d.heroAlt} schema={schema}>
  <PageHero title={fill(d.h1)} lede={fill(d.lede)} image={img(d.heroImage)} imageAlt={d.heroAlt} crumbs={crumbs}>
    <div class="hero-cta">
      <WhatsAppButton message={`Hi ${site.shortName}, I'm looking for a ${d.enquiry} in Wayanad. Dates: ___, guests: ___`} />
      <a class="btn btn--ghost" href={`tel:${site.phoneE164}`}>Call {site.phone}</a>
    </div>
  </PageHero>

  <div class="wrap stack">
    <AnswerBox q={answer.q} a={answer.a} updated={d.updated} />

    {
      matched.length > 0 && (
        <section aria-labelledby="rooms-title">
          <h2 id="rooms-title">Stays that fit</h2>
          <div class="cards">
            {matched.map((m) => (
              <RoomCard room={m.room} note={m.note} />
            ))}
          </div>
        </section>
      )
    }



    <section class="prose body">
      <Content />
    </section>



    {
      d.places.length > 0 && (
        <section aria-labelledby="near-title">
          <h2 id="near-title">Places to visit</h2>
          <PlaceTable only={d.places} linkToGuide />
        </section>
      )
    }

    <section aria-labelledby="faq-title" class="faq-wrap">
      <h2 id="faq-title">Questions</h2>
      <Faq items={faqs} />
    </section>
  </div>

  <section class="section section--tea" aria-labelledby="enq-title">
    <div class="wrap">
      <h2 id="enq-title">Send your dates on WhatsApp</h2>
      <p class="lede">Fill in your name and number, pick dates if you know them, and WhatsApp opens with everything typed in.</p>
      <EnquiryForm context={d.enquiry} />
    </div>
  </section>

  <div class="wrap stack">
    <RelatedPages slugs={d.related} />
    <TrustBlock updated={d.updated} />
  </div>
</Base>

<style>
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.4rem;
  }
  .hero-cta .btn--ghost {
    color: #fff;
  }
  .stack {
    display: grid;
    gap: var(--space-l);
    padding-block: var(--space-l);
  }
  .stack > * {
    min-width: 0;
  }
  .cards {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .body {
    max-width: 68ch;
    font-size: var(--step-1);
    line-height: 1.65;
  }
  .body :global(table) {
    font-size: var(--step-0);
    background: var(--paper);
    display: block;
    overflow-x: auto;
  }
  .faq-wrap {
    max-width: 52rem;
  }
</style>

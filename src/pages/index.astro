---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import RoomCard from '../components/RoomCard.astro';
import TierCards from '../components/TierCards.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Experiences from '../components/Experiences.astro';
import PlaceTable from '../components/PlaceTable.astro';
import Gallery from '../components/Gallery.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import MapSchematic from '../components/MapSchematic.astro';
import Faq from '../components/Faq.astro';
import ContourLines from '../components/ContourLines.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../data/site';
import { reach } from '../data/places';
import { faq } from '../data/faq';
import { img, creditLine } from '../lib/images';
import { faqSchema } from '../lib/schema';
import RelatedPages from '../components/RelatedPages.astro';
import { getLandingPages } from '../lib/landing';

const rooms = (await getCollection('rooms')).sort((a, b) => a.data.order - b.data.order);
const { published: landingPages } = await getLandingPages();

const gallery: { key: string; alt: string; caption: string; size?: 'big' | 'tall' | 'wide' }[] = [
  { key: 'gallery/misty-valley-from-tea-estate', alt: 'Low cloud filling a valley below a Wayanad tea estate', caption: 'Morning cloud in the valley below the tea estates', size: 'big' },
  { key: 'gallery/chembra-grassland', alt: 'Green grassland and a lone tree on the slopes of Chembra Peak', caption: 'Grassland on the Chembra Peak trail' },
  { key: 'gallery/peacock-tholpetty', alt: 'A peacock walking through grass in Tholpetty Wildlife Sanctuary', caption: 'Peacock in Tholpetty Wildlife Sanctuary' },
  { key: 'gallery/coffee-plants-wayanad', alt: 'Coffee bushes growing under tall shade trees in Wayanad', caption: 'Coffee growing under shade trees', size: 'tall' },
  { key: 'gallery/kuruva-island-river', alt: 'Trees leaning over the Kabini river at Kuruva Island', caption: 'The Kabini river at Kuruva Island' },
  { key: 'gallery/banasura-hills-and-fields', alt: 'Banasura hills rising behind farmland and the reservoir edge', caption: 'Banasura hills from the dam road', size: 'wide' },
  { key: 'gallery/tea-bushes-under-silver-oak', alt: 'Rows of tea bushes under tall silver oak trees in Vythiri', caption: 'Tea and silver oaks in Vythiri' },
  { key: 'gallery/pookode-lake-shore', alt: 'Forest-lined shore of Pookode Lake under a blue sky', caption: 'Pookode Lake, 3 km from Vythiri' },
  { key: 'gallery/sulthan-bathery-paddy-fields', alt: 'Paddy fields near Sulthan Bathery with forest behind', caption: 'Paddy fields near Sulthan Bathery', size: 'wide' },
  { key: 'gallery/chembra-from-en-ooru', alt: 'Wide view of the Chembra range from En Ooru tribal heritage village', caption: 'The Chembra range from En Ooru' },
];

const chooseRows = [
  ['Location', 'Wayanad is large; a central base saves hours of driving.', 'We suggest resorts near the sights you plan to see, mostly around Vythiri, Kalpetta and Meppadi.'],
  ['Road access', 'Some hill resorts are reached only by jeep track.', 'We tell you about rough last stretches and steps before you book.'],
  ['Views', 'Higher ground means cooler nights and more mist.', 'Ask us for valley-view, lake-view or forest-edge stays.'],
  ['Room type', 'Couples, families and groups need different rooms.', 'Pool villas, tree houses, plantation cottages, family suites and private villas.'],
  ['Budget', 'Rates in the same area can differ by several times.', 'Private, luxury, affordable and budget options for the same dates.'],
  ['Booking', 'Comparing resorts one by one takes days of calls.', 'One WhatsApp message; we send what is free and book the one you choose.'],
];
---

<Base
  keywords={['best resort in Wayanad', 'resort in Wayanad', 'Wayanad resorts', 'resort booking Wayanad', 'private resort in Wayanad', 'luxury resort in Wayanad', 'budget resort in Wayanad', 'pool villa Wayanad', 'tree house Wayanad', 'resortinwayanad']}
  alternates={[
    { lang: 'en-IN', href: '/' },
    { lang: 'ml-IN', href: '/ml/' },
  ]}
  title="Best Resorts in Wayanad – Pool Villas, Tree Houses | Mistvale"
  description="Find and book the best resort in Wayanad for your trip: private, luxury, affordable and budget resorts, pool villas and tree houses. Send your dates on WhatsApp."
  schema={[faqSchema(faq)]}
>
  <Hero
    eyebrow="Resort booking across Wayanad, Kerala"
    title="Find the best resort in Wayanad for your trip"
    lede="Private, luxury, affordable and budget resorts: pool villas, tree houses, plantation cottages and family suites. Send your dates on WhatsApp and we reply with what is free."
  />

  <section class="section rooms-section" id="rooms" aria-labelledby="rooms-title">
    <div class="wrap">
      <h2 id="rooms-title">Wayanad resorts for every budget</h2>
      <p class="lede">Pick a budget or a kind of stay. We send the resorts that have rooms free for your dates, with photos and the rate.</p>
      <TierCards />
      <h3 class="types-title">Kinds of stay</h3>
      <div class="room-grid">
        {rooms.map((room) => <RoomCard room={room} note={room.data.summary} />)}
      </div>
      <p class="all-rooms"><a href="/rooms/">See all stay types</a></p>
    </div>
  </section>

  <section class="facts-strip" aria-label="Resort at a glance">
    <dl class="wrap facts">
      {
        site.facts.map((f) => (
          <div>
            <dt>{f.value}</dt>
            <dd>{f.label}</dd>
          </div>
        ))
      }
      <div><dt>1</dt><dd>WhatsApp message to compare resorts</dd></div>
    </dl>
  </section>

  <section class="section" id="about" aria-labelledby="about-title">
    <div class="wrap split">
      <div>
        <h2 id="about-title">Wayanad resort booking, done for you</h2>
        <p class="lede">
          {site.name} is a resort booking service for Wayanad, Kerala. We work with resorts, villas, tree houses and
          plantation stays across the district, so you can tell us what you want once and get a short list that fits.
        </p>
        <p>
          Tell us your dates, who is travelling and your budget. We check which resorts have rooms free, send you photos and
          rates on WhatsApp, and book the one you pick. You get the resort's name, address and booking details in writing
          before you travel.
        </p>
        <p><a href="/where-to-stay-in-wayanad/">Not sure which part of Wayanad to stay in? Read our area guide.</a></p>
      </div>
      <figure>
        <Picture
          src={img('about/vythiri-tea-garden-morning-mist')}
          alt="Tea bushes and tall silver oaks in a Vythiri estate on a misty morning"
          formats={['avif', 'webp']}
          widths={[400, 560, 720, 880, 1040, 1200]}
          sizes="(min-width: 1240px) 520px, (min-width: 900px) 42vw, 92vw"
          quality={52}
          class="rounded"
        />
        <figcaption class="credit">Tea garden in Vythiri. {creditLine('about/vythiri-tea-garden-morning-mist')}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section how" aria-labelledby="how-title">
    <div class="wrap">
      <h2 id="how-title">How booking works</h2>
      <HowItWorks />
    </div>
  </section>

  <section class="section find" aria-label="Find the right stay">
    <div class="wrap">
      <RelatedPages slugs={landingPages.map((p) => p.id)} title="Find the right stay" />
    </div>
  </section>

  <section class="section section--tea choose" aria-labelledby="choose-title">
    <ContourLines class="choose-lines" />
    <div class="wrap">
      <h2 id="choose-title">How to choose the best resort in Wayanad</h2>
      <p class="lede">
        The best resort in Wayanad for you depends on where you stay, how easy the road is and the kind of room you need. These
        are the six things we check for every guest, and how we help.
      </p>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th scope="col">What to check</th><th scope="col">Why it matters</th><th scope="col">How we help</th></tr>
          </thead>
          <tbody>
            {
              chooseRows.map(([what, why, us]) => (
                <tr>
                  <th scope="row">{what}</th>
                  <td data-label="Why it matters">{why}</td>
                  <td data-label="How we help">{us}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" id="experiences" aria-labelledby="exp-title">
    <div class="wrap">
      <h2 id="exp-title">Things to do on your trip</h2>
      <p class="lede">Most resorts can arrange these. Tell us what you want to do and we suggest resorts that offer it.</p>
      <Experiences />
    </div>
  </section>

  <section class="section explore" id="explore" aria-labelledby="explore-title">
    <div class="wrap">
      <h2 id="explore-title">Places to visit in Wayanad</h2>
      <p class="lede">
        From {site.baseTown} in the south of Wayanad, Pookode Lake, Chembra Peak, Soochipara Falls and Banasura Sagar Dam are
        all within an hour. The wildlife sanctuaries and Thirunelli make good full-day trips.
      </p>
      <PlaceTable linkToGuide />
      <p><a href="/things-to-do-in-wayanad/">Read the full guide to places to visit in Wayanad</a></p>
    </div>
  </section>

  <section class="section" id="gallery" aria-labelledby="gallery-title">
    <div class="wrap">
      <h2 id="gallery-title">Wayanad in pictures</h2>
      <p class="lede">The hills, lakes and wildlife of Wayanad. Tap a photo to see it larger.</p>
      <Gallery items={gallery} />
    </div>
  </section>

  <section class="section section--tea" id="enquire" aria-labelledby="enquire-title">
    <div class="wrap">
      <h2 id="enquire-title">Check availability</h2>
      <p class="lede">Pick your dates and we will reply on WhatsApp with resorts that are free, with photos and the rate.</p>
      <EnquiryForm />
    </div>
  </section>

  <section class="section" id="reach" aria-labelledby="reach-title">
    <div class="wrap split">
      <div>
        <h2 id="reach-title">How to reach Wayanad</h2>
        <p class="lede">
          The nearest airport is Kozhikode (Calicut), about 90 km or 2.5 to 3 hours away. Wayanad has no railway; Kozhikode
          station is the closest. From Bengaluru it is a 6.5 to 7 hour drive through Mysuru.
        </p>
        <div class="table-scroll">
          <table>
            <thead>
              <tr><th scope="col">From</th><th scope="col">Distance</th><th scope="col">Time</th></tr>
            </thead>
            <tbody>
              {
                reach.map((r) => (
                  <tr>
                    <th scope="row">
                      {r.href ? <a href={r.href}>{r.from}</a> : r.from}
                      <span class="note">{r.note}</span>
                    </th>
                    <td>{r.km}</td>
                    <td>{r.time}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p><a href="/contact/">Contact us and how booking works</a></p>
      </div>
      <MapSchematic />
    </div>
  </section>

  <section class="section faq-section" id="faq" aria-labelledby="faq-title">
    <div class="wrap narrow-wrap">
      <h2 id="faq-title">Questions guests ask</h2>
      <Faq items={faq} />
    </div>
  </section>

  <section class="final section section--tea" aria-labelledby="final-title">
    <ContourLines class="final-lines" />
    <div class="wrap">
      <h2 id="final-title">Your Wayanad resort is a message away</h2>
      <p class="lede">Send your dates on WhatsApp. You talk to a person who knows Wayanad resorts, not a call centre.</p>
      <WhatsAppButton label={`WhatsApp ${site.phone}`} />
    </div>
  </section>
</Base>

<style>
  .facts-strip {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1rem;
    margin-block: 0;
    padding-block: 1.4rem;
  }
  .facts dt {
    font-family: var(--font-display-stack);
    font-size: var(--step-2);
    color: var(--tea);
    line-height: 1.1;
  }
  .facts dd {
    margin: 0;
    color: var(--monsoon-ink);
    font-size: var(--step--1);
  }
  .split {
    display: grid;
    gap: var(--space-l);
    align-items: start;
  }
  @media (min-width: 900px) {
    .split {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  figure {
    margin: 0;
  }
  :global(.rounded img),
  :global(img.rounded) {
    border-radius: var(--radius);
  }
  .rooms-section {
    background: var(--paper);
  }
  .types-title {
    margin-top: var(--space-l);
    font-size: var(--step-2);
  }
  .how {
    background: var(--mist-2);
  }
  .room-grid {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    margin-top: var(--space-l);
  }
  .all-rooms {
    margin-top: var(--space-l);
    font-weight: 600;
  }
  .choose,
  .final {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  :global(.choose-lines),
  :global(.final-lines) {
    position: absolute;
    inset: 0;
    z-index: -1;
    color: rgb(255 255 255 / 0.07);
  }
  .choose th,
  .choose td {
    border-color: rgb(255 255 255 / 0.18);
  }
  .choose th {
    color: #fff;
  }
  .choose thead th {
    color: var(--turmeric-light);
    font-size: var(--step--1);
  }
  .choose table {
    min-width: 38rem;
  }
  @media (max-width: 700px) {
    .choose table,
    .choose tbody,
    .choose tr,
    .choose th,
    .choose td {
      display: block;
      min-width: 0;
    }
    .choose thead {
      display: none;
    }
    .choose tr {
      padding-block: 1rem;
      border-bottom: 1px solid rgb(255 255 255 / 0.18);
    }
    .choose th,
    .choose td {
      border: 0;
      padding: 0.25rem 0;
    }
    .choose th {
      font-family: var(--font-display-stack);
      font-weight: 400;
      font-size: var(--step-1);
    }
    .choose td::before {
      content: attr(data-label);
      display: block;
      font-size: var(--step--1);
      font-weight: 600;
      color: var(--turmeric-light);
    }
  }
  .explore {
    background: var(--mist-2);
  }
  .note {
    display: block;
    font-weight: 400;
    font-size: var(--step--1);
    color: var(--monsoon-ink);
  }
  .narrow-wrap {
    max-width: 52rem;
  }
  .final {
    text-align: center;
  }
  .final h2 {
    max-width: 22ch;
    margin-inline: auto;
  }
  .final .lede {
    margin-inline: auto;
    margin-bottom: 1.6rem;
  }
</style>

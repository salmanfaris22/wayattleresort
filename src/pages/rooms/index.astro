---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import RoomCard from '../../components/RoomCard.astro';
import TierCards from '../../components/TierCards.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { img } from '../../lib/images';
import { breadcrumbSchema, stayListSchema } from '../../lib/schema';

const rooms = (await getCollection('rooms')).sort((a, b) => a.data.order - b.data.order);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Stays', href: '/rooms/' },
];
const listId = new URL('/rooms/#stays', Astro.site).href;
---

<Base
  keywords={['Wayanad resorts', 'Wayanad resort rooms', 'pool villa Wayanad', 'tree house Wayanad', 'plantation stay Wayanad', 'family room Wayanad', 'couple friendly resorts Wayanad']}
  title="Wayanad Resorts by Type: Pool Villas, Tree Houses & More"
  description="Pool villas, tree houses, plantation cottages, family suites and couple stays across Wayanad, from luxury to budget. Tell us your dates and we book one for you."
  schema={[breadcrumbSchema(crumbs, Astro.site!), stayListSchema(rooms.map((r) => ({ id: r.id, name: r.data.name })), listId, 'Stay types we book in Wayanad', Astro.site!)]}
>
  <PageHero
    title="Wayanad resorts we can book for you"
    lede="Five kinds of stay in Wayanad resorts, at every budget. Tell us who is travelling and we send the ones free for your dates."
    image={img('hero/wayanad-tea-estate-misty-hills')}
    imageAlt="Tea estates on the Wayanad hills under low cloud"
    crumbs={crumbs}
  />

  <section class="section list">
    <div class="wrap">
      <h2>Stay types</h2>
      <div class="room-grid">
        {rooms.map((room) => <RoomCard room={room} note={room.data.summary} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Wayanad resorts for every budget</h2>
      <p class="lede">From whole private villas to simple cottages. Rates change with the season, so we confirm the price on WhatsApp.</p>
      <TierCards />
    </div>
  </section>

  <section class="section list">
    <div class="wrap">
      <h2>How booking works</h2>
      <HowItWorks />
    </div>
  </section>

  <section class="section">
    <div class="wrap cta">
      <h2>Not sure which stay fits?</h2>
      <p class="lede">Tell us who is travelling, your dates and your budget. We will suggest resorts that suit you.</p>
      <WhatsAppButton message="Hi, we are ___ adults and ___ children, travelling on ___, budget ___. Which resort do you suggest?" />
    </div>
  </section>
</Base>

<style>
  .list {
    background: var(--paper);
  }
  .room-grid {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
</style>

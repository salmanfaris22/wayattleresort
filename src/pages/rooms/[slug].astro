---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import { roomMessage } from '../../lib/whatsapp';
import { breadcrumbSchema, stayTypeSchema } from '../../lib/schema';
import { creditLine } from '../../lib/images';
import { tiers } from '../../data/site';
import RelatedPages from '../../components/RelatedPages.astro';

export async function getStaticPaths() {
  const rooms = (await getCollection('rooms')).sort((a, b) => a.data.order - b.data.order);
  return rooms.map((room) => ({ params: { slug: room.id }, props: { room, others: rooms.filter((r) => r.id !== room.id) } }));
}

interface Props {
  room: CollectionEntry<'rooms'>;
  others: CollectionEntry<'rooms'>[];
}
const { room, others } = Astro.props;
const r = room.data;
const { Content } = await render(room);
const url = new URL(`/rooms/${room.id}/`, Astro.site).href;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Stays', href: '/rooms/' },
  { name: r.name, href: `/rooms/${room.id}/` },
];
const ogImg = await getImage({ src: r.image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const budgetList = r.tiers.map((id) => tiers.find((t) => t.id === id)!.name.replace(' resorts', '')).join(', ');
---

<Base
  keywords={[r.keyword, `${r.name} Wayanad`, `${r.name} booking`, 'resort booking Wayanad']}
  title={r.seoTitle}
  description={r.seoDescription}
  ogImage={r.image}
  ogAlt={r.imageAlt}
  schema={[stayTypeSchema(r, url, new URL(ogImg.src, Astro.site).href, Astro.site!), breadcrumbSchema(crumbs, Astro.site!)]}
>
  <PageHero
    title={`${r.name} stays in Wayanad`}
    lede={r.summary}
    image={r.image}
    imageAlt={r.imageAlt}
    crumbs={crumbs}
    stockPhoto={r.stockPhoto}
  >
    <div class="hero-cta">
      <WhatsAppButton message={roomMessage(r.name)} label={`Find a ${r.name.toLowerCase()}`} />
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap layout">
      <div class="prose">
        <Content />
      </div>
      <aside class="card" aria-labelledby="spec-title">
        <h2 id="spec-title">At a glance</h2>
        <dl>
          <div><dt>Guests</dt><dd>{r.guestsNote}</dd></div>
          <div><dt>Budgets</dt><dd>{budgetList}</dd></div>
          <div><dt>Check-in / out</dt><dd>Depends on the resort; we confirm it when you book</dd></div>
        </dl>
        <h3>What to expect</h3>
        <ul>{r.features.map((a) => <li>{a}</li>)}</ul>
        <h3>Best for</h3>
        <ul>{r.goodFor.map((a) => <li>{a}</li>)}</ul>
        <WhatsAppButton message={roomMessage(r.name)} label="Ask on WhatsApp" />
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>How booking works</h2>
      <HowItWorks />
    </div>
  </section>

  <section class="section other">
    <div class="wrap">
      <h2>Other stays</h2>
      <ul class="others" role="list">
        {
          others.map((o) => (
            <li>
              <a href={`/rooms/${o.id}/`}>{o.data.name}</a>
              <span>{o.data.guestsNote}</span>
            </li>
          ))
        }
      </ul>
      <RelatedPages slugs={[...r.related, 'things-to-do-in-wayanad']} title="Also useful" />
      {r.stockPhoto && <p class="credit">The photo on this page is an example of this kind of stay, not a specific resort. {creditLine(r.imageCredit)}</p>}
    </div>
  </section>
</Base>

<style>
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.4rem;
    margin-top: 1.4rem;
  }
  .layout {
    display: grid;
    gap: var(--space-l);
    align-items: start;
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 1.5fr 1fr;
    }
    .card {
      position: sticky;
      top: 5.5rem;
    }
  }
  .prose {
    max-width: 65ch;
    font-size: var(--step-1);
    line-height: 1.65;
  }
  .card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-m);
  }
  .card h2 {
    font-size: var(--step-2);
  }
  .card h3 {
    font-family: var(--font-body-stack);
    font-weight: 600;
    font-size: var(--step-0);
    margin-top: 1.2rem;
    color: var(--pepper);
  }
  .card dl {
    display: grid;
    gap: 0.6rem;
    margin: 0;
  }
  .card dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.5rem;
  }
  .card dt {
    color: var(--monsoon-ink);
  }
  .card dd {
    margin: 0;
    text-align: right;
  }
  .card ul {
    margin: 0 0 1.4rem;
  }
  .other {
    background: var(--mist-2);
  }
  .others {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .others li {
    background: var(--paper);
    padding: 1rem 1.2rem;
    border-radius: var(--radius);
    display: grid;
    gap: 0.2rem;
  }
  .others a {
    font-family: var(--font-display-stack);
    font-size: var(--step-1);
  }
  .others span {
    color: var(--monsoon-ink);
    font-size: var(--step--1);
  }
</style>

---
// Malayalam landing page (ml-IN), paired with the English home page via hreflang.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { site } from '../../data/site';
import { getRooms } from '../../lib/inventory';
import { img } from '../../lib/images';
import { faqSchema, webPageSchema, breadcrumbSchema } from '../../lib/schema';

const rooms = await getRooms();
const ml: Record<string, string> = {
  'pool-villa': 'പ്രൈവറ്റ് പൂൾ വില്ല',
  'tree-house': 'ട്രീ ഹൗസ്',
  'plantation-cottage': 'പ്ലാന്റേഷൻ കോട്ടേജ്',
  'family-suite': 'ഫാമിലി സ്യൂട്ട്',
  'couple-stay': 'കപ്പിൾ സ്റ്റേ',
};
const mlTiers = [
  ['പ്രൈവറ്റ് റിസോർട്ടുകൾ', 'നിങ്ങളുടെ ഗ്രൂപ്പിന് മാത്രമായി മുഴുവൻ വില്ലയോ ചെറിയ റിസോർട്ടോ; പലതിലും പ്രൈവറ്റ് പൂൾ.'],
  ['ലക്ഷ്വറി റിസോർട്ടുകൾ', 'പൂൾ വില്ല, വാലി വ്യൂ, സ്പാ. ഹണിമൂണിനും വാർഷികത്തിനും.'],
  ['അഫോർഡബിൾ റിസോർട്ടുകൾ', 'പൂളും നല്ല ഭക്ഷണവുമുള്ള സുഖപ്രദമായ റൂമുകൾ, മിതമായ നിരക്കിൽ.'],
  ['ബജറ്റ് റിസോർട്ടുകൾ', 'വൃത്തിയുള്ള ലളിതമായ കോട്ടേജുകളും ഹോംസ്റ്റേകളും, കുറഞ്ഞ നിരക്കിൽ.'],
];
const faqs = [
  {
    q: 'നിങ്ങൾ വഴി വയനാട്ടിൽ റിസോർട്ട് എങ്ങനെ ബുക്ക് ചെയ്യാം?',
    a: `${site.phone} എന്ന നമ്പറിൽ വാട്സ്ആപ്പ് ചെയ്യുക. തീയതി, എത്ര പേർ, ബജറ്റ് എന്നിവ അയച്ചാൽ ആ ദിവസങ്ങളിൽ ഒഴിവുള്ള റിസോർട്ടുകൾ ഫോട്ടോയും നിരക്കും സഹിതം അയച്ചുതരും. ഇഷ്ടപ്പെട്ടത് തിരഞ്ഞെടുത്താൽ ഞങ്ങൾ ബുക്ക് ചെയ്യും.`,
  },
  {
    q: 'ഏതൊക്കെ തരം റിസോർട്ടുകൾ ലഭ്യമാണ്?',
    a: 'പ്രൈവറ്റ്, ലക്ഷ്വറി, അഫോർഡബിൾ, ബജറ്റ് റിസോർട്ടുകൾ. പൂൾ വില്ല, ട്രീ ഹൗസ്, പ്ലാന്റേഷൻ കോട്ടേജ്, ഫാമിലി സ്യൂട്ട്, കപ്പിൾ സ്റ്റേ എന്നിവ വയനാട്ടിലെ പല ഭാഗങ്ങളിലും ബുക്ക് ചെയ്തുതരാം.',
  },
  {
    q: 'വലിയ ഗ്രൂപ്പിന് റിസോർട്ട് കിട്ടുമോ?',
    a: 'കിട്ടും. ഗ്രൂപ്പിന് മാത്രമായി ബുക്ക് ചെയ്യാവുന്ന പ്രൈവറ്റ് വില്ലകളും ധാരാളം റൂമുകളുള്ള റിസോർട്ടുകളും ഞങ്ങൾ കണ്ടെത്തിത്തരും. എത്ര പേർ, എത്ര റൂം, ടെമ്പോ ട്രാവലറോ ബസോ വരുന്നുണ്ടോ എന്ന് അറിയിക്കുക.',
  },
  {
    q: 'ചെക്ക്-ഇൻ സമയവും ക്യാൻസലേഷൻ നിയമങ്ങളും എല്ലായിടത്തും ഒന്നാണോ?',
    a: 'അല്ല. ഓരോ റിസോർട്ടിനും സ്വന്തം ചെക്ക്-ഇൻ സമയവും അഡ്വാൻസ്, ക്യാൻസലേഷൻ നിയമങ്ങളുമുണ്ട്. പണം അടയ്ക്കുന്നതിനു മുമ്പ് നിങ്ങൾ തിരഞ്ഞെടുത്ത റിസോർട്ടിന്റെ നിയമങ്ങൾ ഞങ്ങൾ അറിയിക്കും.',
  },
  {
    q: 'വയനാട് സന്ദർശിക്കാൻ ഏറ്റവും നല്ല സമയം ഏതാണ്?',
    a: 'ഒക്ടോബർ മുതൽ മെയ് വരെ. ഡിസംബർ, ജനുവരി മാസങ്ങളിൽ നല്ല തണുപ്പും തെളിഞ്ഞ കാഴ്ചകളും. ജൂൺ മുതൽ സെപ്റ്റംബർ വരെയുള്ള മഴക്കാലത്ത് കോടമഞ്ഞും നിറഞ്ഞൊഴുകുന്ന വെള്ളച്ചാട്ടങ്ങളും കാണാം, പക്ഷേ ചില ട്രെക്കിംഗുകൾ അടച്ചിരിക്കും.',
  },
];
const url = new URL('/ml/', Astro.site).href;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'മലയാളം', href: '/ml/' },
];
const description = `വയനാട്ടിലെ പ്രൈവറ്റ്, ലക്ഷ്വറി, അഫോർഡബിൾ, ബജറ്റ് റിസോർട്ടുകൾ ഞങ്ങൾ ബുക്ക് ചെയ്തുതരാം: പൂൾ വില്ല, ട്രീ ഹൗസ്, ഫാമിലി സ്യൂട്ട്. വാട്സ്ആപ്പിൽ തീയതി അയക്കുക.`;
---

<Base
  keywords={['വയനാട് റിസോർട്ട്', 'വയനാട് റിസോർട്ട് ബുക്കിംഗ്', 'wayanad resort', 'വയനാട് പൂൾ വില്ല']}
  lang="ml-IN"
  title="വയനാട് റിസോർട്ട് ബുക്കിംഗ്: പൂൾ വില്ല, ട്രീ ഹൗസ് | Mistvale"
  description={description}
  alternates={[
    { lang: 'en-IN', href: '/' },
    { lang: 'ml-IN', href: '/ml/' },
  ]}
  schema={[webPageSchema({ url, name: 'വയനാട് റിസോർട്ട് ബുക്കിംഗ്', description, lang: 'ml-IN' }, Astro.site!), breadcrumbSchema(crumbs, Astro.site!), { ...faqSchema(faqs), inLanguage: 'ml-IN' }]}
>
  <PageHero
    title="വയനാട്ടിലെ മികച്ച റിസോർട്ട് ഞങ്ങൾ കണ്ടെത്തിത്തരാം"
    lede="കുടുംബത്തിനും കൂട്ടുകാർക്കും ദമ്പതികൾക്കും: പ്രൈവറ്റ്, ലക്ഷ്വറി, അഫോർഡബിൾ, ബജറ്റ് റിസോർട്ടുകൾ. തീയതി വാട്സ്ആപ്പ് ചെയ്താൽ ഒഴിവുള്ളവ അയച്ചുതരും."
    image={img('hero/wayanad-tea-estate-misty-hills')}
    imageAlt="വയനാട്ടിലെ തേയിലത്തോട്ടങ്ങളും കോടമഞ്ഞ് മൂടിയ മലകളും"
    crumbs={crumbs}
  >
    <div class="cta">
      <WhatsAppButton message="നമസ്കാരം, വയനാട്ടിൽ റിസോർട്ട് വേണം. തീയതി: ___, എത്ര പേർ: ___, ബജറ്റ്: ___" label="വാട്സ്ആപ്പിൽ ചോദിക്കാം" />
      <a class="btn btn--ghost" href={`tel:${site.phoneE164}`}>വിളിക്കാം: {site.phone}</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap">
      <h2>ഏത് ബജറ്റിനും റിസോർട്ട്</h2>
      <ul class="list">
        {mlTiers.map(([name, text]) => <li><strong>{name}:</strong> {text}</li>)}
      </ul>

      <h2 class="gap">താമസ രീതികൾ</h2>
      <ul class="list">
        {
          rooms.map((r) => (
            <li>
              <a href={`/rooms/${r.id}/`} lang="en">{ml[r.id] ?? r.data.name}</a>
            </li>
          ))
        }
      </ul>
      <p class="muted">നിരക്ക് സീസൺ അനുസരിച്ച് മാറും. തീയതി സഹിതം വാട്സ്ആപ്പ് ചെയ്യുക.</p>

      <h2 class="gap">ബുക്കിംഗ് എങ്ങനെ</h2>
      <ol class="list">
        <li>തീയതി, എത്ര പേർ, ഏതുതരം താമസം, ബജറ്റ് എന്നിവ വാട്സ്ആപ്പ് ചെയ്യുക.</li>
        <li>ഒഴിവുള്ള റിസോർട്ടുകൾ ഫോട്ടോയും നിരക്കും സഹിതം ഞങ്ങൾ അയക്കും.</li>
        <li>ഇഷ്ടപ്പെട്ടത് തിരഞ്ഞെടുക്കുക; ഞങ്ങൾ ബുക്ക് ചെയ്ത് റിസോർട്ടിന്റെ പേരും വിലാസവും രേഖാമൂലം അയക്കും.</li>
      </ol>

      <h2 class="gap">എങ്ങനെ എത്താം</h2>
      <ul class="list">
        <li>കോഴിക്കോട് അന്താരാഷ്ട്ര വിമാനത്താവളം: ഏകദേശം 90 കി.മീ., 2.5–3 മണിക്കൂർ (താമരശ്ശേരി ചുരം വഴി)</li>
        <li>കോഴിക്കോട് റെയിൽവേ സ്റ്റേഷൻ: ഏകദേശം 65 കി.മീ., 2 മണിക്കൂർ</li>
        <li>ബെംഗളൂരു: ഏകദേശം 290 കി.മീ., മൈസൂരു വഴി 6.5–7 മണിക്കൂർ (ബന്ദിപ്പൂർ വനപാത രാത്രി 9 മുതൽ രാവിലെ 6 വരെ അടച്ചിരിക്കും)</li>
      </ul>
      <p class="muted">ദൂരം വൈത്തിരി വരെ; നിങ്ങളുടെ റിസോർട്ട് അനുസരിച്ച് മാറാം.</p>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap narrow-wrap">
      <h2>പതിവ് ചോദ്യങ്ങൾ</h2>
      <Faq items={faqs} />
      <p class="en"><a href="/" hreflang="en" lang="en">Read this page in English</a></p>
    </div>
  </section>
</Base>

<style>
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.4rem;
  }
  .cta .btn--ghost {
    color: #fff;
  }
  .gap {
    margin-top: var(--space-l);
  }
  .list li + li {
    margin-top: 0.4rem;
  }
  .muted {
    margin-top: 0.6rem;
  }
  .alt {
    background: var(--paper);
  }
  .narrow-wrap {
    max-width: 52rem;
  }
  .en {
    margin-top: 1.5rem;
  }
  h1,
  h2 {
    line-height: 1.35;
  }
</style>

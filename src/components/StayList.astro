---
// Filterable list of named partner resorts. Without JavaScript every card shows and the filters stay hidden.
import StayCard from './StayCard.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import type { Stay } from '../data/stays';
import { areas } from '../data/areas';
import { tiers } from '../data/site';
import { tripNames } from '../lib/stays';

interface Props {
  stays: Stay[];
}
const { stays } = Astro.props;
const usedAreas = areas.filter((a) => stays.some((s) => s.area === a.id));
const usedTiers = tiers.filter((t) => stays.some((s) => s.tier === t.id));
const usedTrips = (Object.keys(tripNames) as (keyof typeof tripNames)[]).filter((k) => stays.some((s) => s.bestFor.includes(k)));
const anyPrivatePool = stays.some((s) => s.pool === 'private');
---

<div class="stay-list" data-stay-list>
  <form class="filters" aria-label="Filter resorts" data-filters hidden>
    <label>
      <span>Area</span>
      <select name="area">
        <option value="">All areas</option>
        {usedAreas.map((a) => <option value={a.id}>{a.name}</option>)}
      </select>
    </label>
    <label>
      <span>Budget</span>
      <select name="tier">
        <option value="">Any budget</option>
        {usedTiers.map((t) => <option value={t.id}>{t.name.replace(' resorts', '')}</option>)}
      </select>
    </label>
    <label>
      <span>Trip</span>
      <select name="for">
        <option value="">Any trip</option>
        {usedTrips.map((k) => <option value={k}>{tripNames[k]}</option>)}
      </select>
    </label>
    <label>
      <span>Guests</span>
      <input type="number" name="guests" min="1" max="99" inputmode="numeric" placeholder="Any" />
    </label>
    {
      anyPrivatePool && (
        <label class="check">
          <input type="checkbox" name="pool" value="private" />
          <span>Private pool</span>
        </label>
      )
    }
  </form>
  <p class="count" aria-live="polite" data-count></p>
  <div class="grid" data-cards>
    {stays.map((s) => <StayCard stay={s} />)}
  </div>
  <div class="empty" data-empty hidden>
    <p>No resort on this list matches all of that. We book many more than we list here: send your trip on WhatsApp and we will check.</p>
    <WhatsAppButton />
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-stay-list]')) {
    const form = root.querySelector<HTMLFormElement>('[data-filters]')!;
    const cards = [...root.querySelectorAll<HTMLElement>('[data-cards] > *')];
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    form.hidden = false;
    const apply = () => {
      const f = new FormData(form);
      const area = String(f.get('area') ?? '');
      const tier = String(f.get('tier') ?? '');
      const trip = String(f.get('for') ?? '');
      const guests = Number(f.get('guests')) || 0;
      const pool = f.get('pool') === 'private';
      let shown = 0;
      for (const card of cards) {
        const d = card.dataset;
        const ok =
          (!area || d.area === area) &&
          (!tier || d.tier === tier) &&
          (!trip || (d.for ?? '').split(' ').includes(trip)) &&
          (!guests || guests <= Number(d.max)) &&
          (!pool || d.pool === 'private');
        card.hidden = !ok;
        if (ok) shown++;
      }
      count.textContent = `Showing ${shown} of ${cards.length} resorts`;
      empty.hidden = shown > 0;
    };
    form.addEventListener('input', apply);
    form.addEventListener('submit', (e) => e.preventDefault());
    apply();
  }
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1rem;
    align-items: end;
    margin-block: var(--space-m) 0.6rem;
  }
  .filters[hidden],
  .empty[hidden] {
    display: none;
  }
  .filters label {
    display: grid;
    gap: 0.25rem;
    font-size: var(--step--1);
    font-weight: 600;
  }
  .filters select,
  .filters input[type='number'] {
    font: inherit;
    font-weight: 400;
    min-height: 2.75rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    color: inherit;
  }
  .filters input[type='number'] {
    width: 6.5rem;
  }
  .filters .check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
  }
  .filters .check input {
    width: 1.2rem;
    height: 1.2rem;
  }
  .count {
    font-size: var(--step--1);
    color: var(--monsoon-ink);
    min-height: 1.4em;
  }
  .grid {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .grid > :global(*) {
    min-width: 0;
  }
  .empty {
    margin-top: var(--space-m);
  }
</style>

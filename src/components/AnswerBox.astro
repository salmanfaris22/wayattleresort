---
// Answer-first block: a question heading and a short, self-contained answer (AEO).
interface Props {
  q: string;
  a: string;
  updated?: Date;
}
const { q, a, updated } = Astro.props;
---

<section class="answer" aria-labelledby="answer-q">
  <h2 id="answer-q">{q}</h2>
  <p>{a}</p>
  {
    updated && (
      <p class="updated">
        Updated <time datetime={updated.toISOString().slice(0, 10)}>{updated.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time>
      </p>
    )
  }
</section>

<style>
  .answer {
    background: var(--paper);
    border: 1px solid var(--line);
    border-left: 4px solid var(--turmeric);
    border-radius: var(--radius);
    padding: var(--space-m);
    max-width: 62rem;
  }
  h2 {
    font-size: var(--step-2);
    margin-bottom: 0.4em;
  }
  p {
    font-size: var(--step-1);
    line-height: 1.55;
    margin: 0;
  }
  .updated {
    margin-top: 0.8rem;
    font-size: var(--step--1);
    color: var(--monsoon-ink);
  }
</style>

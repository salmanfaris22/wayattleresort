---
import { Picture } from 'astro:assets';
import { experiences } from '../data/experiences';
import { img } from '../lib/images';
---

<ul class="bento" role="list">
  {
    experiences.map((e) => (
      <li class:list={['tile', e.size, { text: !e.image }]}>
        {e.image && (
          <Picture
            src={img(e.image)}
            alt=""
            formats={['avif', 'webp']}
            widths={[400, 640, 960]}
            sizes={e.size === 'wide' || e.size === 'feature' ? '(min-width: 1000px) 50vw, 100vw' : '(min-width: 1000px) 25vw, (min-width: 700px) 50vw, 100vw'}
            quality={52}
          />
        )}
        <div class="copy">
          <h3>{e.title}</h3>
          <p>{e.text}</p>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .bento {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
    grid-template-columns: 1fr;
    grid-auto-rows: minmax(16rem, auto);
  }
  @media (min-width: 700px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .bento {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 15rem;
      grid-auto-flow: dense;
    }
    .feature {
      grid-column: span 2;
      grid-row: span 2;
    }
    .wide {
      grid-column: span 2;
    }
    .tall {
      grid-row: span 2;
    }
  }
  .tile {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    display: flex;
    align-items: flex-end;
    background: var(--tea-2);
    color: #fff;
    isolation: isolate;
  }
  .tile :global(picture),
  .tile :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .tile::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgb(12 26 20 / 0.88), rgb(12 26 20 / 0.2) 65%, transparent);
  }
  .tall :global(img) {
    object-position: 50% 85%;
  }
  .tile.text {
    background: var(--mist-2);
    color: var(--pepper);
    border: 1px solid var(--line);
  }
  .tile.text::before {
    display: none;
  }
  .copy {
    padding: 1.2rem 1.3rem;
  }
  h3 {
    color: inherit;
    font-size: var(--step-1);
    margin-bottom: 0.3rem;
  }
  .tile.text h3 {
    color: var(--tea);
  }
  .copy p {
    margin: 0;
    font-size: var(--step--1);
    line-height: 1.5;
  }
</style>

---
import { site } from '../data/site';

interface Props {
  updated?: Date;
}
const { updated } = Astro.props;
---

<aside class="trust" aria-labelledby="trust-title">
  <h2 id="trust-title">About {site.name}</h2>
  <p>
    A resort booking service for Wayanad, Kerala. We work with resorts, villas, tree houses and plantation stays across the
    district, check which are free for your dates and book the one you choose.
  </p>
  <dl>
    <div><dt>Area</dt><dd>All of Wayanad, Kerala</dd></div>
    <div><dt>Phone and WhatsApp</dt><dd><a href={`tel:${site.phoneE164}`}>{site.phone}</a></dd></div>
    <div><dt>Resort rules</dt><dd><a href="/contact/#policies">Check-in, advance and cancellation</a></dd></div>
  </dl>
  {
    updated && (
      <p class="muted">
        Page checked and updated on <time datetime={updated.toISOString().slice(0, 10)}>{updated.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time>.
      </p>
    )
  }
</aside>

<style>
  .trust {
    background: var(--mist-2);
    border-radius: var(--radius);
    padding: var(--space-m);
  }
  h2 {
    font-size: var(--step-2);
  }
  dl {
    display: grid;
    gap: 0.6rem 2rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    margin: 1rem 0;
  }
  dt {
    font-size: var(--step--1);
    color: var(--monsoon-ink);
  }
  dd {
    margin: 0;
  }
  .muted {
    margin: 0;
  }
</style>

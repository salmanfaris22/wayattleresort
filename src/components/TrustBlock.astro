---
import { site, fullAddress, fmtTime } from '../data/site';

interface Props {
  updated?: Date;
}
const { updated } = Astro.props;
---

<aside class="trust" aria-labelledby="trust-title">
  <h2 id="trust-title">About {site.name}</h2>
  <p>
    A small resort on a tea and coffee estate in {site.address.locality}, {site.address.district}, run by the people who answer your
    messages. You book directly with us; there is no booking fee.
  </p>
  <dl>
    <div><dt>Address</dt><dd>{fullAddress}</dd></div>
    <div><dt>Phone and WhatsApp</dt><dd><a href={`tel:${site.phoneE164}`}>{site.phone}</a></dd></div>
    <div><dt>Check-in / out</dt><dd>{fmtTime(site.checkIn)} / {fmtTime(site.checkOut)}</dd></div>
    <div><dt>Policies</dt><dd><a href="/contact/#policies">Advance, cancellation and children</a></dd></div>
  </dl>
  {
    updated && (
      <p class="muted">
        Page checked and updated on <time datetime={updated.toISOString().slice(0, 10)}>{updated.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time>.
      </p>
    )
  }
</aside>

<style>
  .trust {
    background: var(--mist-2);
    border-radius: var(--radius);
    padding: var(--space-m);
  }
  h2 {
    font-size: var(--step-2);
  }
  dl {
    display: grid;
    gap: 0.6rem 2rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    margin: 1rem 0;
  }
  dt {
    font-size: var(--step--1);
    color: var(--monsoon-ink);
  }
  dd {
    margin: 0;
  }
  .muted {
    margin: 0;
  }
</style>

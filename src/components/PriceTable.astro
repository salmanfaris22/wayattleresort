---
import type { Room } from '../lib/inventory';
import { inr } from '../lib/inventory';
import { site } from '../data/site';

interface Props {
  rooms: Room[];
}
const { rooms } = Astro.props;
---

<div class="table-scroll">
  <table class="prices">
    <caption>Room rates</caption>
    <thead>
      <tr>
        <th scope="col">Room</th>
        <th scope="col">Sleeps</th>
        <th scope="col">From / night</th>
        <th scope="col">Extra mattress</th>
      </tr>
    </thead>
    <tbody>
      {
        rooms.map((r) => (
          <tr>
            <th scope="row">
              <a href={`/rooms/${r.id}/`}>{r.data.name}</a>
              {r.data.units > 1 && <span class="units">{r.data.units} rooms of this type</span>}
            </th>
            <td>{r.data.guestsNote}</td>
            <td>{inr(r.data.priceFrom)}</td>
            <td>{r.data.sleeps > r.data.guests ? `${inr(site.extraMattressPrice)}, up to ${r.data.sleeps - r.data.guests}` : 'Not available'}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
<p class="muted">Prices are per room per night for the guests shown, with breakfast, before GST. Weekend and holiday rates are higher.</p>

<style>
  .prices {
    min-width: 36rem;
    background: var(--paper);
  }
  caption {
    text-align: left;
    font-family: var(--font-display-stack);
    font-size: var(--step-2);
    color: var(--tea);
    padding-bottom: 0.6rem;
  }
  .units {
    display: block;
    font-weight: 400;
    font-size: var(--step--1);
    color: var(--monsoon-ink);
  }
  td:nth-child(3) {
    white-space: nowrap;
    font-weight: 600;
  }
  .muted {
    margin-top: 0.6rem;
  }
</style>

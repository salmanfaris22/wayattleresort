---
// Thin topographic contour lines — the site's one decorative motif.
interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<svg class:list={['contours', cls]} viewBox="0 0 1200 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-width="1.1" vector-effect="non-scaling-stroke">
    <path d="M-20 330c120-40 210-110 330-105s170 80 300 70 190-120 330-125 180 60 290 40"></path>
    <path d="M-20 290c110-45 200-125 320-122s185 70 305 58 180-130 320-138 200 50 300 30"></path>
    <path d="M-20 250c100-50 190-140 310-140s190 60 310 46 170-140 310-150 210 40 310 18"></path>
    <path d="M-20 210c95-55 185-150 300-155s195 50 315 34 160-150 300-162 215 30 325 6"></path>
    <path d="M140 160c40-45 100-80 160-78s110 40 100 70-80 46-140 40-150 10-120-32Z"></path>
    <path d="M190 150c30-28 70-46 110-44s70 22 62 40-52 28-92 24-104 6-80-20Z"></path>
    <path d="M760 120c50-50 120-80 180-74s96 40 80 70-90 40-150 34-160 12-110-30Z"></path>
    <path d="M820 110c30-28 74-44 112-40s60 24 48 40-56 24-94 20-96 4-66-20Z"></path>
  </g>
</svg>

<style is:global>
  /* zero specificity so each page can size and colour the lines */
  :where(.contours) {
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

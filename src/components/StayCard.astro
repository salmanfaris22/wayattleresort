---
// One named partner resort in the home page list. Data attributes drive the filters in StayList.
import { Picture } from 'astro:assets';
import type { Stay } from '../data/stays';
import { site, tiers } from '../data/site';
import { img } from '../lib/images';
import { waLink } from '../lib/whatsapp';
import { areaOf, poolNames, stayMessage, typeNames } from '../lib/stays';

interface Props {
  stay: Stay;
}
const { stay } = Astro.props;
const href = `/resorts/${stay.slug}/`;
const cover = stay.photos[0];
const tier = tiers.find((t) => t.id === stay.tier)!.name.replace(' resorts', '');
const sleeps = stay.sleeps.min === stay.sleeps.max ? `${stay.sleeps.max}` : `${stay.sleeps.min} to ${stay.sleeps.max}`;
const showPrice = site.showPrices && stay.priceFrom;
---

<article
  class="stay-card"
  data-area={stay.area}
  data-tier={stay.tier}
  data-for={stay.bestFor.join(' ')}
  data-pool={stay.pool}
  data-max={stay.sleeps.max}
>
  <a class="media" href={href} tabindex="-1" aria-hidden="true">
    <Picture src={img(cover.key)} alt="" formats={['avif', 'webp']} widths={[320, 480, 640, 900]} sizes="(min-width: 1240px) 290px, (min-width: 700px) 45vw, 92vw" quality={52} />
  </a>
  <div class="body">
    <h3><a href={href}>{stay.name}</a></h3>
    <p class="meta">{stay.locality}, {areaOf(stay).name} · sleeps {sleeps}</p>
    <ul class="specs" role="list" aria-label="Details">
      {stay.types.map((t) => <li>{typeNames[t]}</li>)}
      {stay.pool !== 'none' && <li>{poolNames[stay.pool]}</li>}
      <li>{tier}</li>
    </ul>
    {showPrice && <p class="price">From ₹{stay.priceFrom!.toLocaleString('en-IN')} a night</p>}
    <p class="links">
      <a href={waLink(stayMessage(stay))} target="_blank" rel="noopener" data-wa>Check dates on WhatsApp</a>
      <a href={href}>Details<span class="visually-hidden">: {stay.name}</span></a>
    </p>
  </div>
</article>

<style>
  .stay-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .stay-card[hidden] {
    display: none;
  }
  .media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    background: var(--mist-2);
  }
  .media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    padding: 1rem 1.15rem 1.2rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  h3 {
    font-size: var(--step-1);
    margin-bottom: 0.35rem;
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }
  .meta {
    font-size: var(--step--1);
    color: var(--monsoon-ink);
    margin-bottom: 0.4rem;
  }
  .specs {
    list-style: none;
    padding: 0;
    margin: 0 0 0.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .specs li {
    font-size: 0.78rem;
    background: var(--mist);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }
  .price {
    font-weight: 600;
    margin-bottom: 0.6rem;
  }
  .links {
    margin: auto 0 0;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    font-weight: 600;
  }
  .links a {
    padding-block: 0.4rem;
  }
</style>

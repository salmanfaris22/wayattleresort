---
import { site } from '../data/site';

interface Props {
  keys: string[];
}
const { keys } = Astro.props;
const labels: Record<string, string> = {
  pool: 'Swimming pool',
  privatePool: 'Private plunge pool',
  campfire: 'Campfire',
  barbecue: 'Barbecue',
  restaurant: 'Restaurant',
  parking: 'Parking',
  wifi: 'Wi-Fi',
  powerBackup: 'Power backup',
  kidsPool: 'Separate kids pool',
};
const facilities = site.facilities as Record<string, { available: boolean; note: string }>;
const items = keys.filter((k) => facilities[k]).map((k) => ({ label: labels[k] ?? k, ...facilities[k] }));
---

<ul class="facilities" role="list">
  {
    items.map((f) => (
      <li class:list={{ no: !f.available }}>
        <span class="mark" aria-hidden="true">{f.available ? '✓' : '✕'}</span>
        <span>
          <strong>
            {f.label}
            {!f.available && <span class="visually-hidden"> (not available)</span>}
          </strong>
          {f.note}
        </span>
      </li>
    ))
  }
</ul>

<style>
  .facilities {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.8rem 2rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  li {
    display: flex;
    gap: 0.7rem;
    align-items: baseline;
  }
  strong {
    display: block;
  }
  .mark {
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--tea);
    color: #fff;
    font-size: 0.85rem;
  }
  .no .mark {
    background: var(--mist-2);
    color: var(--pepper);
  }
</style>

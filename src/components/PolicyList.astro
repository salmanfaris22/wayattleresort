---
import { site, fmtTime } from '../data/site';
const p = site.policies;
const rows = [
  ['Check-in / check-out', `${fmtTime(site.checkIn)} / ${fmtTime(site.checkOut)}`],
  ['Advance', p.advance],
  ['Cancellation', p.cancellation],
  ['Children', p.children],
  ['ID proof', p.idProof],
  ['Quiet hours', p.quietHours],
];
---

<dl class="policies">
  {
    rows.map(([k, v]) => (
      <div>
        <dt>{k}</dt>
        <dd>{v}</dd>
      </div>
    ))
  }
</dl>

<style>
  .policies {
    margin: 0;
    display: grid;
    gap: 0;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .policies div {
    display: grid;
    grid-template-columns: minmax(8rem, 14rem) 1fr;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--line);
  }
  .policies div:last-child {
    border-bottom: 0;
  }
  dt {
    font-weight: 600;
    color: var(--tea);
  }
  dd {
    margin: 0;
  }
  @media (max-width: 600px) {
    .policies div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>

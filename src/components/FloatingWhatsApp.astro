---
import { waLink } from '../lib/whatsapp';
import WaIcon from './WaIcon.astro';
---

<a class="float-wa" href={waLink()} target="_blank" rel="noopener" aria-label="Chat on WhatsApp to check availability">
  <WaIcon />
  <span>Check dates</span>
</a>

<style>
  .float-wa {
    position: fixed;
    right: 1rem;
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 60;
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 52px;
    padding: 0.7rem 1.1rem;
    border-radius: 999px;
    background: var(--turmeric);
    color: var(--pepper);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.5);
  }
  .float-wa :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
    flex: none;
  }
  @media (max-width: 900px) {
    .float-wa {
      display: inline-flex;
    }
  }
</style>

---
import { site } from '../data/site';
import { getRooms } from '../lib/inventory';
import WaIcon from './WaIcon.astro';

interface Props {
  /** What the guest is asking about, e.g. "family stay" — added to the WhatsApp message */
  context?: string;
  /** Pre-select a room by name */
  room?: string;
}
const { context, room } = Astro.props;
const rooms = await getRooms();
const greeting = `Hi ${site.shortName}, I'd like to check availability${context ? ` for a ${context}` : ''}.`;
---

<form class="enquiry" action="https://api.whatsapp.com/send" method="get" target="_blank" data-enquiry>
  <input type="hidden" name="phone" value={site.whatsapp} />
  <input type="hidden" name="text" value={greeting} />
  <div class="field">
    <label for="eq-name">Your name</label>
    <input id="eq-name" type="text" data-k="Name" autocomplete="name" required maxlength="60" />
  </div>
  <div class="field">
    <label for="eq-phone">Phone / WhatsApp</label>
    <input id="eq-phone" type="tel" data-k="Phone" autocomplete="tel" inputmode="tel" required pattern="[0-9+()\- ]{10,16}" placeholder="+91 98765 43210" />
  </div>
  <div class="field">
    <label for="eq-in">Check-in</label>
    <input id="eq-in" type="date" data-k="Check-in" />
  </div>
  <div class="field">
    <label for="eq-out">Check-out</label>
    <input id="eq-out" type="date" data-k="Check-out" />
  </div>
  <div class="field">
    <label for="eq-guests">Guests</label>
    <select id="eq-guests" data-k="Guests">
      {['1', '2', '3', '4', '5', '6', '7–10', '11–16'].map((g) => <option selected={g === '2'}>{g}</option>)}
    </select>
  </div>
  <div class="field">
    <label for="eq-room">Room</label>
    <select id="eq-room" data-k="Room">
      <option>Not sure yet</option>
      {rooms.map((r) => <option selected={r.data.name === room}>{r.data.name}</option>)}
      {site.wholeProperty.available && <option>Whole resort (private group)</option>}
    </select>
  </div>
  <button class="btn btn--wa" type="submit"><WaIcon /><span>Send on WhatsApp</span></button>
  <p class="note">
    Opens WhatsApp with your details filled in. Nothing is stored on this website. We usually reply within an hour, 8 am to 10 pm, or call
    <a href={`tel:${site.phoneE164}`}>{site.phone}</a>.
  </p>
</form>

<script is:inline>
  (() => {
    const f = document.querySelector('[data-enquiry]');
    if (!f) return;
    const today = new Date().toISOString().slice(0, 10);
    const ci = f.querySelector('#eq-in'),
      co = f.querySelector('#eq-out');
    ci.min = co.min = today;
    ci.addEventListener('change', () => (co.min = ci.value || today));
    const nice = (v) => new Date(v + 'T00:00').toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
    f.addEventListener('submit', () => {
      const lines = [];
      f.querySelectorAll('[data-k]').forEach((el) => {
        let v = el.value.trim();
        if (!v) v = el.type === 'date' ? 'not decided' : '-';
        else if (el.type === 'date') v = nice(v);
        lines.push(el.dataset.k + ': ' + v);
      });
      if (ci.value && co.value) {
        const n = Math.round((new Date(co.value) - new Date(ci.value)) / 864e5);
        if (n > 0) lines.push('Nights: ' + n);
      }
      lines.push('Page: ' + location.pathname);
      f.elements.text.value = f.elements.text.defaultValue + '\n' + lines.join('\n');
    });
  })();
</script>

<style>
  .enquiry {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    align-items: end;
    background: var(--paper);
    padding: var(--space-m);
    border-radius: var(--radius);
    border: 1px solid var(--line);
    color: var(--pepper);
  }
  .field {
    display: grid;
    gap: 0.35rem;
  }
  label {
    font-weight: 600;
    font-size: var(--step--1);
  }
  input,
  select {
    font: inherit;
    min-height: 48px;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--monsoon);
    border-radius: var(--radius);
    background: #fff;
    color: var(--pepper);
    width: 100%;
  }
  input:user-invalid {
    border-color: #a3341f;
  }
  .enquiry .btn {
    grid-column: 1 / -1;
    justify-self: start;
  }
  .note {
    grid-column: 1 / -1;
    margin: 0;
    font-size: var(--step--1);
    color: var(--monsoon-ink);
  }
  .note a {
    color: var(--tea);
  }
</style>

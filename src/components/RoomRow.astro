---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import WhatsAppButton from './WhatsAppButton.astro';
import { roomMessage } from '../lib/whatsapp';

interface Props {
  room: CollectionEntry<'rooms'>;
  flip?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { room, flip = false, headingLevel = 'h3' } = Astro.props;
const r = room.data;
const H = headingLevel;
const inr = (n: number) => `₹${n.toLocaleString('en-IN')}`;
---

<article class:list={['room', { flip }]}>
  <a class="media" href={`/rooms/${room.id}/`} tabindex="-1" aria-hidden="true">
    <Picture
      src={r.image}
      alt=""
      formats={['avif', 'webp']}
      widths={[480, 720, 960, 1280]}
      sizes="(min-width: 900px) 55vw, 100vw"
      quality={52}
    />
    {r.stockPhoto && <span class="tag">Sample photo</span>}
  </a>
  <div class="body">
    <H class="title"><a href={`/rooms/${room.id}/`}>{r.name}</a></H>
    <p>{r.summary}</p>
    <dl class="specs">
      <div><dt>Guests</dt><dd>{r.guestsNote}</dd></div>
      <div><dt>Size</dt><dd>{r.sizeSqft} sq ft</dd></div>
      <div><dt>Bed</dt><dd>{r.bed}</dd></div>
      <div><dt>From</dt><dd><strong>{inr(r.priceFrom)}</strong> a night, breakfast included</dd></div>
    </dl>
    <div class="cta">
      <WhatsAppButton message={roomMessage(r.name)} label={`Ask about the ${r.name.toLowerCase()}`} />
      <a href={`/rooms/${room.id}/`}>Room details<span class="visually-hidden">: {r.name}</span></a>
    </div>
  </div>
</article>

<style>
  .room {
    display: grid;
    gap: var(--space-m) var(--space-l);
    align-items: center;
  }
  @media (min-width: 900px) {
    .room {
      grid-template-columns: 1.15fr 1fr;
    }
    .room.flip .media {
      order: 2;
    }
  }
  .media {
    position: relative;
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--mist-2);
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .media:hover :global(img) {
    transform: scale(1.03);
  }
  .tag {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    background: rgb(27 29 26 / 0.75);
    color: #fff;
    font-size: 0.75rem;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
  }
  .title a {
    text-decoration: none;
    color: inherit;
  }
  .specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem 1.5rem;
    margin: 1.2rem 0 1.5rem;
    padding-block: 1rem;
    border-block: 1px solid var(--line);
  }
  .specs dt {
    font-size: var(--step--1);
    color: var(--monsoon-ink);
  }
  .specs dd {
    margin: 0;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.4rem;
  }
  .cta > a {
    font-weight: 600;
    padding-block: 0.75rem;
  }
</style>
